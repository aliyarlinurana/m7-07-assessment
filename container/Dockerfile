# ─────────────────────────────────────────────────────────────────────────────
# Stage 1 — dependency builder
# Compiles Python wheels in a full build environment.
# Nothing from this stage reaches the runtime image except the installed packages.
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

# Install only what's needed to compile wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy locked dependency manifest first — maximises layer cache hit rate.
# requirements.txt is generated by pip-compile (pip-tools); never hand-edited.
COPY requirements.txt .

# Install into an isolated prefix so we can copy just the packages to runtime
RUN pip install --upgrade pip==24.0 && \
    pip install --no-cache-dir --prefix=/install -r requirements.txt

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2 — model bake-in
# Copies the ONNX model artifact from a build-arg-supplied S3 path.
# The model is baked into the image so every pod starts with zero external
# dependency on model storage at runtime (see container/README.md §Bake vs Mount).
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS model-fetcher

# AWS CLI is only needed in this stage; it never reaches the runtime image
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        unzip \
    && curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/awscliv2.zip /tmp/aws \
    && rm -rf /var/lib/apt/lists/*

# MODEL_S3_URI is injected by the CI/CD pipeline at build time.
# Example: s3://northstar-mlflow-artifacts/northstar-reranker/v2.4.1/model.onnx
ARG MODEL_S3_URI
ARG MODEL_SHA256

WORKDIR /model

RUN --mount=type=secret,id=aws_credentials,target=/root/.aws/credentials \
    aws s3 cp "${MODEL_S3_URI}" ./model.onnx

# Verify integrity before baking in — fail fast if artifact is corrupt or tampered
RUN echo "${MODEL_SHA256}  model.onnx" | sha256sum --check -

# ─────────────────────────────────────────────────────────────────────────────
# Stage 3 — runtime
# Minimal image: no build tools, no AWS CLI, no pip cache.
# Runs as a non-root user.
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

LABEL org.opencontainers.image.title="northstar-infer" \
      org.opencontainers.image.description="NorthStar recommendation re-ranking inference service" \
      org.opencontainers.image.vendor="NorthStar Platform Team" \
      org.opencontainers.image.source="https://github.com/northstar/recommendation-service"

# libgomp1 is required by ONNX Runtime for CPU parallelism
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy installed Python packages from builder stage
COPY --from=builder /install /usr/local

# Copy verified model artifact from model-fetcher stage
COPY --from=model-fetcher /model/model.onnx /app/model/model.onnx

# Copy application source
WORKDIR /app
COPY src/ ./src/

# Create non-root user and set ownership
RUN groupadd --gid 10001 appgroup && \
    useradd --uid 10001 --gid appgroup --no-create-home --shell /sbin/nologin appuser && \
    chown -R appuser:appgroup /app

USER appuser

# Expose application port
EXPOSE 8080

# Runtime environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=2 \
    MODEL_PATH=/app/model/model.onnx \
    PORT=8080

# Healthcheck — liveness probe used by Kubernetes and the load balancer
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')"

# Gunicorn + Uvicorn workers: 2 workers × 2 threads saturates a 4-vCPU node
# at 800 RPS with the lightweight re-ranker (see serving/capacity-plan.md)
CMD ["python", "-m", "gunicorn", \
     "src.main:app", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--workers", "2", \
     "--threads", "2", \
     "--bind", "0.0.0.0:8080", \
     "--timeout", "30", \
     "--graceful-timeout", "20", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
